# Configuración para publicación automática (solo el administrador del sitio)
# Agrega estas variables en Vercel → Settings → Environment Variables

GITHUB_TOKEN=           # Token de GitHub con permiso de escritura al repo
GITHUB_REPO=ashp98072-dot/LogiserviciosMonaco
GITHUB_BRANCH=main
CMS_ADMIN_PIN=1234      # Mismo PIN que usa RRHH en /admin

# Formulario de contacto: configurar solo en el servidor / Vercel (sin prefijo VITE_)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@logiserviciosmonaco.com
SMTP_PASS=
CONTACT_TO=info@logiserviciosmonaco.com
CONTACT_CC=administracion2@logiserviciosmonaco.com
